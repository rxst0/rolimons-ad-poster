# Copy this file to ".env" and paste your Rolimons verification cookie value.
# Get it from rolimons.com (logged in + verified): DevTools > Application > Cookies >
# https://www.rolimons.com > _RoliVerification. Paste ONLY the value, not the name.
# NEVER share this value. This tool does NOT use or need your .ROBLOSECURITY cookie.
ROLI_VERIFICATION=paste_your_cookie_value_here
